AI_DB_CONNECTION=
DB_AI_HOST=127.0.0.1
DB_AI_PORT=3306
DB_AI_DATABASE=cws_pos
DB_AI_USERNAME=ai_readonly
DB_AI_PASSWORD=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

